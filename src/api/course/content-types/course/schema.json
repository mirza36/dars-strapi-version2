{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Main_Dars"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Slug": {
      "type": "uid",
      "targetField": "Title",
      "required": true
    },
    "Description": {
      "type": "text"
    },
    "Author": {
      "type": "string"
    },
    "Cover_Image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "PartsCount": {
      "type": "integer"
    },
    "parts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::part.part",
      "mappedBy": "main_dar"
    },
    "DarsLevel": {
      "type": "integer"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "courses"
    }
  }
}
