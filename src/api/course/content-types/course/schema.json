{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Course"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Slug": {
      "type": "uid",
      "targetField": "Title",
      "required": true
    },
    "Description": {
      "type": "text"
    },
    "levels": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::level.level",
      "mappedBy": "course"
    },
    "Is_Featured": {
      "type": "boolean",
      "default": false
    },
    "Author": {
      "type": "string"
    },
    "Cover_Image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "Category": {
      "type": "enumeration",
      "required": true,
      "default": "Others",
      "enum": [
        "Others",
        "Irfan-e-Islami",
        "Ulema Ki Zindagi"
      ]
    },
    "LevelCount": {
      "type": "integer"
    }
  }
}
