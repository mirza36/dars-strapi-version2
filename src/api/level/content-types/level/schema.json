{
  "kind": "collectionType",
  "collectionName": "levels",
  "info": {
    "singularName": "level",
    "pluralName": "levels",
    "displayName": "Level"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "levels"
    },
    "Title": {
      "type": "string",
      "required": true
    },
    "Order": {
      "type": "integer",
      "default": 1
    },
    "parts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::part.part",
      "mappedBy": "level"
    },
    "level_quiz": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::level-quiz.level-quiz",
      "mappedBy": "level"
    }
  }
}
