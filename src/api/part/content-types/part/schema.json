{
  "kind": "collectionType",
  "collectionName": "parts",
  "info": {
    "singularName": "part",
    "pluralName": "parts",
    "displayName": "Parts_of_Main_Dars"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Order": {
      "type": "integer",
      "required": true,
      "unique": false,
      "min": 1
    },
    "Content_Text": {
      "type": "blocks"
    },
    "Audio_File": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "audios"
      ]
    },
    "PDF_Notes": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "part_quiz": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::part-quiz.part-quiz",
      "mappedBy": "part"
    },
    "main_dar": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "parts"
    }
  }
