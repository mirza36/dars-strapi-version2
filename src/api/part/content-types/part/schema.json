{
  "kind": "collectionType",
  "collectionName": "parts",
  "info": {
    "singularName": "part",
    "pluralName": "parts",
    "displayName": "Part"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "level": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::level.level",
      "inversedBy": "parts"
    },
    "Title": {
      "type": "string",
      "required": true
    },
    "Order": {
      "type": "integer",
      "default": 1
    },
    "Content_Text": {
      "type": "blocks"
    },
    "Audio_File": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "audios"
      ]
    },
    "PDF_Notes": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "part_quiz": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::part-quiz.part-quiz",
      "mappedBy": "part"
    },
    "user_progresses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-progress.user-progress",
      "mappedBy": "part"
    }
  }
}
